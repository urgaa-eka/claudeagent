# Copy to .env (or export in your shell). Only ANTHROPIC_API_KEY is required.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults are baked into the code by the scaffold step):
AGENT_ID=__AGENT_ID__
ENVIRONMENT_ID=__ENVIRONMENT_ID__

# Optional: attach Managed Agents Vault credential(s) at session create, to
# authenticate connected MCP servers (e.g. the Samsung S24 device bridge).
# Comma-separated vlt_ ids. The MCP *server URL* is declared on the AGENT, not
# here (see agent/README.md). Leave empty for a plain client with no device link.
VAULT_IDS=
